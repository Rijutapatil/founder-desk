# Copy to .env and fill in. .env is gitignored.
#
# Nothing here is required. Every measured path - ingestion, retrieval, the
# evaluation and the CI gate - runs with no key, no billing and no network
# beyond fetching the public sources.

# "identity" (default) or "cross-encoder". The cross-encoder needs the optional
# reranking extra: pip install -e ".[rerank]"
RERANKER=identity
